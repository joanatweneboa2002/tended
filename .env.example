# Copy this file to .env and fill in your own values. Never commit .env.
# The backend reads .env from this folder first, then from one folder up.
# Values in this folder's .env win over the one above it.

# Your own OpenAI API key
OPENAI_API_KEY=

# The model every AI call uses (change it here to switch models)
OPENAI_MODEL=

# Optional limits for one "Run check" on the owner's Home tab
# TENDED_MAX_AI_CALLS_PER_RUN=5
# TENDED_TOKEN_BUDGET_PER_RUN=40000
