# Copy this file to .env and fill in ONE of the two options below. Never commit .env.
# The backend reads .env from this folder first, then from one folder up
# (values in this folder's .env win). Restart the backend after changing it.

# --- Option 1 (main): your own OpenAI API key ---------------------------------
OPENAI_API_KEY=
# Optional. Leave blank to use the default model, gpt-5.6-luna.
OPENAI_MODEL=

# --- Option 2: the course Portkey key -------------------------------------------
# Used only when OPENAI_API_KEY is empty. Calls go through https://api.portkey.ai/v1
# with the model gpt-6-luna.
PORTKEY_API_KEY=

# If both keys are set, OpenAI is used. If neither is set, the app still runs
# but the AI features explain which key to add.

# --- Optional limits for one "Run check" on the owner's Home tab ---------------
# TENDED_MAX_AI_CALLS_PER_RUN=5
# TENDED_TOKEN_BUDGET_PER_RUN=40000
